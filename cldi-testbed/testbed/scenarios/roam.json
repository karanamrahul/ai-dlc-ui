{
  "id": "roam",
  "title": "Roam between two BSSes on the DUT (same SSID, different radios)",
  "proves": "Reassociation moves the peer between vdevs with no stale peer left on the old BSS and no data stall.",
  "applies_to": {
    "drivers": [
      "ath10k",
      "ath11k",
      "ath12k"
    ],
    "requires_caps": []
  },
  "components": [
    "wpa_supplicant",
    "mac80211",
    "driver.roam",
    "driver.peer",
    "driver.vdev",
    "wmi",
    "htt"
  ],
  "loops": 10,
  "cooldown_s": 10,
  "expected": {
    "peers_after": 0
  },
  "signals": [
    "peers(per loop, both BSS)",
    "dmesg",
    "throughput"
  ],
  "gates": [
    "crash",
    "timeouts",
    "peer_leak",
    "throughput"
  ],
  "steps": {
    "setup": [
      {
        "id": "iperf_srv",
        "on": "dut",
        "action": "setup",
        "cmd": "pidof iperf3 >/dev/null || iperf3 -s -D",
        "ignore_rc": true
      },
      {
        "id": "ap_up",
        "on": "dut",
        "action": "check",
        "cmd": "(for i in $(seq 1 60); do hostapd_cli -i {ap_if} status | grep -q state=ENABLED && exit 0; sleep 1; done; exit 1)",
        "timeout_s": 90
      },
      {
        "id": "sup_up",
        "on": "peer",
        "action": "setup",
        "cmd": "pidof wpa_supplicant >/dev/null || wpa_supplicant -B -D nl80211 -i {sta_if} -c {wpa_conf_slo}",
        "ignore_rc": true
      },
      {
        "id": "assoc",
        "on": "peer",
        "action": "assoc",
        "cmd": "wpa_cli -i {sta_if} reconnect && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      }
    ],
    "loop": [
      {
        "id": "roam_b",
        "on": "peer",
        "action": "roam",
        "cmd": "wpa_cli -i {sta_if} roam {bssid_b} && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      },
      {
        "id": "ping",
        "on": "peer",
        "action": "check",
        "cmd": "ping -c 3 -W 1 {dut_ip}"
      },
      {
        "id": "roam_a",
        "on": "peer",
        "action": "roam",
        "cmd": "wpa_cli -i {sta_if} roam {bssid_a} && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      },
      {
        "id": "tput",
        "on": "peer",
        "action": "traffic",
        "cmd": "iperf3 -c {dut_ip} -t 5 -R -J",
        "capture": "iperf3",
        "timeout_s": 40
      }
    ],
    "teardown": [
      {
        "id": "disassoc",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 1
      }
    ]
  }
}

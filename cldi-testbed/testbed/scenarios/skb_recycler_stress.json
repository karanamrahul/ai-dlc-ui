{
  "id": "skb_recycler_stress",
  "title": "SKB recycler: burst traffic then idle; pool must return to baseline",
  "proves": "Every skb taken from the QSDK recycler pool comes back (or is freed) once traffic stops; no slow drain of skbuff_head_cache.",
  "applies_to": {
    "drivers": [
      "ath10k",
      "ath11k",
      "ath12k"
    ],
    "requires_qsdk": true,
    "requires_caps": [
      "recycler"
    ]
  },
  "components": [
    "recycler",
    "skb",
    "driver.dp_tx",
    "driver.dp_rx",
    "nss"
  ],
  "loops": 30,
  "cooldown_s": 15,
  "expected": {
    "peers_after": 0
  },
  "signals": [
    "recycler(pre/per loop/post)",
    "slab(per loop)",
    "dmesg",
    "meminfo"
  ],
  "gates": [
    "crash",
    "recycler",
    "slab_slope"
  ],
  "steps": {
    "setup": [
      {
        "id": "iperf_srv",
        "on": "dut",
        "action": "setup",
        "cmd": "pidof iperf3 >/dev/null || iperf3 -s -D",
        "ignore_rc": true
      },
      {
        "id": "ap_up",
        "on": "dut",
        "action": "check",
        "cmd": "(for i in $(seq 1 60); do hostapd_cli -i {ap_if} status | grep -q state=ENABLED && exit 0; sleep 1; done; exit 1)",
        "timeout_s": 90
      },
      {
        "id": "sup_up",
        "on": "peer",
        "action": "setup",
        "cmd": "pidof wpa_supplicant >/dev/null || wpa_supplicant -B -D nl80211 -i {sta_if} -c {wpa_conf_slo}",
        "ignore_rc": true
      },
      {
        "id": "assoc",
        "on": "peer",
        "action": "assoc",
        "cmd": "wpa_cli -i {sta_if} reconnect && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      }
    ],
    "loop": [
      {
        "id": "burst",
        "on": "peer",
        "action": "traffic",
        "cmd": "iperf3 -c {dut_ip} -u -b 0 -l 1400 -t 5 -R -J",
        "capture": "iperf3",
        "timeout_s": 30
      },
      {
        "id": "idle",
        "on": "dut",
        "action": "idle",
        "cmd": "sleep 3"
      }
    ],
    "teardown": [
      {
        "id": "disassoc",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 1
      }
    ]
  }
}

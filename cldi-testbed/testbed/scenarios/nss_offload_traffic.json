{
  "id": "nss_offload_traffic",
  "title": "NSS offload: TCP/UDP through the NSS data path",
  "proves": "Offloaded data path (wifili/NSS FW) carries traffic at baseline rate with no new drops/exceptions and without falling back to host CPU.",
  "applies_to": {
    "drivers": [
      "ath10k",
      "ath11k",
      "ath12k"
    ],
    "requires_qsdk": true,
    "requires_caps": [
      "nss"
    ]
  },
  "components": [
    "nss",
    "driver.dp_tx",
    "driver.dp_rx",
    "htt",
    "fw",
    "skb"
  ],
  "loops": 5,
  "cooldown_s": 5,
  "expected": {
    "peers_after": 0
  },
  "signals": [
    "nss stats delta",
    "throughput",
    "udp loss",
    "cpu",
    "dmesg"
  ],
  "gates": [
    "crash",
    "timeouts",
    "throughput",
    "udp_loss",
    "cpu",
    "nss"
  ],
  "steps": {
    "setup": [
      {
        "id": "iperf_srv",
        "on": "dut",
        "action": "setup",
        "cmd": "pidof iperf3 >/dev/null || iperf3 -s -D",
        "ignore_rc": true
      },
      {
        "id": "ap_up",
        "on": "dut",
        "action": "check",
        "cmd": "(for i in $(seq 1 60); do hostapd_cli -i {ap_if} status | grep -q state=ENABLED && exit 0; sleep 1; done; exit 1)",
        "timeout_s": 90
      },
      {
        "id": "sup_up",
        "on": "peer",
        "action": "setup",
        "cmd": "pidof wpa_supplicant >/dev/null || wpa_supplicant -B -D nl80211 -i {sta_if} -c {wpa_conf_slo}",
        "ignore_rc": true
      },
      {
        "id": "assoc",
        "on": "peer",
        "action": "assoc",
        "cmd": "wpa_cli -i {sta_if} reconnect && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      },
      {
        "id": "nss_on",
        "on": "dut",
        "action": "check",
        "cmd": "test -d /sys/kernel/debug/qca-nss-drv/stats",
        "placeholder": "NSS stats path is QSDK-version specific; confirms offload is active",
        "ignore_rc": true
      }
    ],
    "loop": [
      {
        "id": "tcp_dl",
        "on": "peer",
        "action": "traffic",
        "cmd": "iperf3 -c {dut_ip} -t {iperf_secs} -R -J",
        "capture": "iperf3",
        "timeout_s": 60
      },
      {
        "id": "tcp_ul",
        "on": "peer",
        "action": "traffic",
        "cmd": "iperf3 -c {dut_ip} -t {iperf_secs} -J",
        "capture": "iperf3",
        "timeout_s": 60
      },
      {
        "id": "udp_dl",
        "on": "peer",
        "action": "traffic",
        "cmd": "iperf3 -c {dut_ip} -u -b 1500M -t {iperf_secs} -R -J",
        "capture": "iperf3",
        "timeout_s": 60
      }
    ],
    "teardown": [
      {
        "id": "disassoc",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 1
      }
    ]
  }
}

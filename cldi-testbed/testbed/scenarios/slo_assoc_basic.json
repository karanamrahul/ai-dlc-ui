{
  "id": "slo_assoc_basic",
  "title": "SLO smoke: associate, TCP DL/UL, disassociate",
  "proves": "Single-link association, data path in both directions, clean teardown. Always selected as smoke.",
  "applies_to": {
    "drivers": [
      "ath10k",
      "ath11k",
      "ath12k"
    ]
  },
  "components": [
    "hostapd",
    "wpa_supplicant",
    "nl80211",
    "cfg80211",
    "mac80211",
    "driver.core",
    "driver.peer",
    "driver.dp_tx",
    "driver.dp_rx",
    "wmi",
    "htt",
    "fw"
  ],
  "loops": 3,
  "cooldown_s": 5,
  "expected": {
    "peers_after": 0
  },
  "signals": [
    "dmesg",
    "ramdump",
    "peers",
    "throughput",
    "cpu",
    "meminfo"
  ],
  "gates": [
    "crash",
    "timeouts",
    "peer_leak",
    "throughput"
  ],
  "steps": {
    "setup": [
      {
        "id": "iperf_srv",
        "on": "dut",
        "action": "setup",
        "cmd": "pidof iperf3 >/dev/null || iperf3 -s -D",
        "ignore_rc": true
      },
      {
        "id": "ap_up",
        "on": "dut",
        "action": "check",
        "cmd": "(for i in $(seq 1 60); do hostapd_cli -i {ap_if} status | grep -q state=ENABLED && exit 0; sleep 1; done; exit 1)",
        "timeout_s": 90
      },
      {
        "id": "sup_up",
        "on": "peer",
        "action": "setup",
        "cmd": "pidof wpa_supplicant >/dev/null || wpa_supplicant -B -D nl80211 -i {sta_if} -c {wpa_conf_slo}",
        "ignore_rc": true
      }
    ],
    "loop": [
      {
        "id": "assoc",
        "on": "peer",
        "action": "assoc",
        "cmd": "wpa_cli -i {sta_if} reconnect && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      },
      {
        "id": "ping",
        "on": "peer",
        "action": "check",
        "cmd": "ping -c 3 -W 1 {dut_ip}"
      },
      {
        "id": "tcp_dl",
        "on": "peer",
        "action": "traffic",
        "cmd": "iperf3 -c {dut_ip} -t {iperf_secs} -R -J",
        "capture": "iperf3",
        "timeout_s": 60
      },
      {
        "id": "tcp_ul",
        "on": "peer",
        "action": "traffic",
        "cmd": "iperf3 -c {dut_ip} -t {iperf_secs} -J",
        "capture": "iperf3",
        "timeout_s": 60
      },
      {
        "id": "disassoc",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 1
      }
    ],
    "teardown": [
      {
        "id": "disassoc",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 1
      }
    ]
  }
}

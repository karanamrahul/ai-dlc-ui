{
  "id": "dfs_cac_radar",
  "title": "DFS: CAC, simulated radar, CSA away, peer survives",
  "proves": "Radar event path (FW -> WMI radar event -> cfg80211 -> hostapd CSA) moves the BSS without vdev/peer corruption.",
  "applies_to": {
    "drivers": [
      "ath10k",
      "ath11k",
      "ath12k"
    ],
    "requires_caps": [
      "dfs"
    ]
  },
  "components": [
    "hostapd",
    "cfg80211",
    "mac80211",
    "driver.dfs",
    "driver.vdev",
    "wmi",
    "fw"
  ],
  "loops": 3,
  "cooldown_s": 10,
  "expected": {
    "peers_after": 0
  },
  "signals": [
    "dmesg",
    "peers",
    "timeouts"
  ],
  "gates": [
    "crash",
    "timeouts",
    "peer_leak"
  ],
  "steps": {
    "setup": [
      {
        "id": "to_dfs",
        "on": "dut",
        "action": "chan_switch",
        "cmd": "hostapd_cli -i {ap_if} chan_switch 5 5260",
        "wait_s": 65,
        "ignore_rc": true
      },
      {
        "id": "sup_up",
        "on": "peer",
        "action": "setup",
        "cmd": "pidof wpa_supplicant >/dev/null || wpa_supplicant -B -D nl80211 -i {sta_if} -c {wpa_conf_slo}",
        "ignore_rc": true
      },
      {
        "id": "assoc",
        "on": "peer",
        "action": "assoc",
        "cmd": "wpa_cli -i {sta_if} reconnect && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      }
    ],
    "loop": [
      {
        "id": "radar",
        "on": "dut",
        "action": "radar",
        "cmd_by_driver": {
          "ath10k": "echo 1 > /sys/kernel/debug/ieee80211/{dut_phy}/ath10k/dfs_simulate_radar",
          "ath11k": "echo 1 > /sys/kernel/debug/ath11k/*/mac0/simulate_radar",
          "ath12k": "echo 1 > {debugfs_dev}/mac0/simulate_radar"
        },
        "placeholder": "radar simulation debugfs node not verified for ath12k / QSDK 12.5",
        "wait_s": 10
      },
      {
        "id": "ap_alive",
        "on": "dut",
        "action": "check",
        "cmd": "(for i in $(seq 1 60); do hostapd_cli -i {ap_if} status | grep -q state=ENABLED && exit 0; sleep 1; done; exit 1)",
        "timeout_s": 90
      },
      {
        "id": "reassoc",
        "on": "peer",
        "action": "check",
        "cmd": "(for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40,
        "ignore_rc": true
      },
      {
        "id": "back_dfs",
        "on": "dut",
        "action": "chan_switch",
        "cmd": "hostapd_cli -i {ap_if} chan_switch 5 5260",
        "wait_s": 65,
        "ignore_rc": true
      }
    ],
    "teardown": [
      {
        "id": "disassoc",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 1
      }
    ]
  }
}

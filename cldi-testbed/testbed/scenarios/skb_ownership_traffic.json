{
  "id": "skb_ownership_traffic",
  "title": "SKB ownership: traffic with peer teardown mid-flight",
  "proves": "TX completions and RX reorder flush for a peer being deleted do not leak or double-free skbs (classic ownership bug: completion arrives after peer free).",
  "applies_to": {
    "drivers": [
      "ath10k",
      "ath11k",
      "ath12k"
    ]
  },
  "components": [
    "mac80211",
    "driver.dp_tx",
    "driver.dp_rx",
    "driver.peer",
    "htt",
    "skb",
    "fw"
  ],
  "loops": 15,
  "cooldown_s": 10,
  "expected": {
    "peers_after": 0
  },
  "signals": [
    "dmesg",
    "slab(per loop)",
    "kmemleak",
    "meminfo",
    "throughput"
  ],
  "gates": [
    "crash",
    "timeouts",
    "slab_slope",
    "kmemleak",
    "peer_leak"
  ],
  "steps": {
    "setup": [
      {
        "id": "iperf_srv",
        "on": "dut",
        "action": "setup",
        "cmd": "pidof iperf3 >/dev/null || iperf3 -s -D",
        "ignore_rc": true
      },
      {
        "id": "ap_up",
        "on": "dut",
        "action": "check",
        "cmd": "(for i in $(seq 1 60); do hostapd_cli -i {ap_if} status | grep -q state=ENABLED && exit 0; sleep 1; done; exit 1)",
        "timeout_s": 90
      },
      {
        "id": "sup_up",
        "on": "peer",
        "action": "setup",
        "cmd": "pidof wpa_supplicant >/dev/null || wpa_supplicant -B -D nl80211 -i {sta_if} -c {wpa_conf_slo}",
        "ignore_rc": true
      }
    ],
    "loop": [
      {
        "id": "assoc",
        "on": "peer",
        "action": "assoc",
        "cmd": "wpa_cli -i {sta_if} reconnect && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      },
      {
        "id": "udp_small_bg",
        "on": "peer",
        "action": "traffic_bg",
        "cmd": "(iperf3 -c {dut_ip} -u -b 0 -l 64 -t 8 -R >/dev/null 2>&1 &)",
        "ignore_rc": true,
        "wait_s": 3
      },
      {
        "id": "disassoc_midflight",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 6
      },
      {
        "id": "assoc",
        "on": "peer",
        "action": "assoc",
        "cmd": "wpa_cli -i {sta_if} reconnect && (for i in $(seq 1 40); do wpa_cli -i {sta_if} status | grep -q wpa_state=COMPLETED && exit 0; sleep 0.5; done; exit 1)",
        "timeout_s": 40
      },
      {
        "id": "tcp_dl",
        "on": "peer",
        "action": "traffic",
        "cmd": "iperf3 -c {dut_ip} -t {iperf_secs} -R -J",
        "capture": "iperf3",
        "timeout_s": 60
      },
      {
        "id": "disassoc",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 1
      }
    ],
    "teardown": [
      {
        "id": "disassoc",
        "on": "peer",
        "action": "disassoc",
        "cmd": "wpa_cli -i {sta_if} disconnect",
        "wait_s": 1
      }
    ]
  }
}
